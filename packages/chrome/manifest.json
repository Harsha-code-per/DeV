{
  "manifest_version": 3,
  "name": "DeV for Chrome",
  "description": "Chat with DeV, your local AI assistant, about the page you're on.",
  "version": "0.1.0",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open DeV", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["sidePanel", "nativeMessaging", "tabs", "scripting"],
  "optional_host_permissions": ["<all_urls>"]
}
