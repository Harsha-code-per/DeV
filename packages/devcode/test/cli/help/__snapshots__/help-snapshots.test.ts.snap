exports[`devcode CLI help-text snapshots every documented command emits stable help text: dev github install --help 1`] = `
"⠀              
█▀▀▄ █▀▀█ █   █
█  █ █▀▀▀ ▀▄ ▄▀
▀▀▀  ▀▀▀▀   ▀

Commands:
  devcode completion                   generate shell completion script
  devcode acp                          start ACP (Agent Client Protocol) server
  devcode mcp                          manage MCP (Model Context Protocol) servers
  devcode catalog <action> [target..]  browse and manage built-in skills, plugins and MCP servers
  devcode [project]                    start dev tui                                       [default]
  devcode attach <url>                 attach to a running DeV Code server
  devcode run [message..]              run dev with a message
  devcode debug                        debugging and troubleshooting tools
  devcode providers                    manage AI providers and credentials           [aliases: auth]
  devcode agent                        manage agents
  devcode upgrade [target]             update DeV Code to the latest release
  devcode uninstall                    show how to remove DeV Code and its data
  devcode serve                        starts a headless DeV Code server
  devcode web                          start a DeV Code server and open the web interface
  devcode models [provider]            list all available models
  devcode stats                        show token usage and cost statistics
  devcode export [sessionID]           export session data as JSON
  devcode import <file>                import session data from JSON file
  devcode pr <number>                  fetch and checkout a GitHub PR branch, then run dev
  devcode session                      manage sessions
  devcode plugin <module>              install plugin and update config              [aliases: plug]
  devcode db                           database tools
  devcode native-host [origin]         native messaging host for DeV for Chrome

Positionals:
  project  path to start dev in                                                             [string]

Options:
  -h, --help             show help                                                         [boolean]
  -v, --version          show version number                                               [boolean]
      --print-logs       print logs to stderr                                              [boolean]
      --log-level        log level              [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure             run without external plugins                                      [boolean]
      --port             port to listen on                                     [number] [default: 0]
      --hostname         hostname to listen on                       [string] [default: "127.0.0.1"]
      --mdns             enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain      custom domain name for mDNS service (default: dev-ai.local)
                                                                  [string] [default: "dev-ai.local"]
      --cors             additional domains to allow for CORS                  [array] [default: []]
  -m, --model            model to use in the format of provider/model                       [string]
  -c, --continue         continue the last session                                         [boolean]
  -s, --session          session id to continue                                             [string]
      --fork             fork the session when continuing (use with --continue or --session)
                                                                                           [boolean]
      --prompt           prompt to use                                                      [string]
      --agent            agent to use                                                       [string]
      --permission-mode  manual (or default) asks, accept-edits approves file edits, plan researches
                         read-only first, auto never asks, goal is auto that keeps going until your
                         first message is verified done
                     [string] [choices: "manual", "default", "accept-edits", "plan", "auto", "goal"]
      --auto             start in auto mode: DeV never asks, and refuses risky actions itself
                                                                          [boolean] [default: false]
      --mini             start the minimal interactive interface          [boolean] [default: false]
      --no-replay        disable mini session history replay on resume and after resize    [boolean]
      --replay-limit     cap visible mini replay to the newest N messages                   [number]
  -w, --worktree         work in a new git worktree under .dev/worktrees, on its own branch
                         (optional name)                                                    [string]
"
`;

