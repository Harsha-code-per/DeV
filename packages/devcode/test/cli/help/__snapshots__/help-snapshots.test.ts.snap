// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`devcode CLI help-text snapshots every documented command emits stable help text: dev acp --help 1`] = `
"devcode acp

start ACP (Agent Client Protocol) server

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --port         port to listen on                                         [number] [default: 0]
      --hostname     hostname to listen on                           [string] [default: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  custom domain name for mDNS service (default: dev-ai.local)
                                                                  [string] [default: "dev-ai.local"]
      --cors         additional domains to allow for CORS                      [array] [default: []]
      --cwd          working directory [string] [default: "<HOME>"]"
`;

exports[`devcode CLI help-text snapshots every documented command emits stable help text: dev mcp --help 1`] = `
"devcode mcp

manage MCP (Model Context Protocol) servers

Commands:
  devcode mcp add [name]     add an MCP server
  devcode mcp list           list MCP servers and their status                         [aliases: ls]
  devcode mcp auth [name]    authenticate with an OAuth-enabled MCP server
  devcode mcp logout [name]  remove OAuth credentials for an MCP server
  devcode mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`devcode CLI help-text snapshots every documented command emits stable help text: dev attach --help 1`] = `
"devcode attach <url>

attach to a running DeV Code server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --dir           directory to run in                                                   [string]
  -c, --continue      continue the last session                                            [boolean]
  -s, --session       session id to continue                                                [string]
      --fork          fork the session when continuing (use with --continue or --session)  [boolean]
  -p, --password      basic auth password (defaults to DEV_SERVER_PASSWORD)                 [string]
  -u, --username      basic auth username (defaults to DEV_SERVER_USERNAME or 'dev')        [string]
      --mini          start the minimal interactive interface             [boolean] [default: false]
      --no-replay     disable mini session history replay on resume and after resize       [boolean]
      --replay-limit  cap visible mini replay to the newest N messages                      [number]"
`;

exports[`devcode CLI help-text snapshots every documented command emits stable help text: dev run --help 1`] = `
"devcode run [message..]

run dev with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help             show help                                                         [boolean]
  -v, --version          show version number                                               [boolean]
      --print-logs       print logs to stderr                                              [boolean]
      --log-level        log level              [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure             run without external plugins                                      [boolean]
      --command          the command to run, use message for args                           [string]
  -c, --continue         continue the last session                                         [boolean]
  -s, --session          session id to continue                                             [string]
      --fork             fork the session before continuing (requires --continue or --session)
                                                                                           [boolean]
  -m, --model            model to use in the format of provider/model                       [string]
      --agent            agent to use                                                       [string]
      --format           format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file             file(s) to attach to message                                        [array]
      --title            title for the session (uses truncated prompt if no value provided) [string]
      --attach           attach to a running DeV Code server (e.g., http://localhost:4096)  [string]
  -p, --password         basic auth password (defaults to DEV_SERVER_PASSWORD)              [string]
  -u, --username         basic auth username (defaults to DEV_SERVER_USERNAME or 'dev')     [string]
      --dir              directory to run in, path on remote server if attaching            [string]
      --port             port for the local server (defaults to random port if no value provided)
                                                                                            [number]
      --variant          model variant (provider-specific reasoning effort, e.g., high, max,
                         minimal)                                                           [string]
      --thinking         show thinking blocks                                              [boolean]
  -i, --interactive      run in direct interactive split-footer mode      [boolean] [default: false]
      --permission-mode  manual (or default) rejects what would ask, accept-edits approves file
                         edits, auto refuses only risky actions, goal is auto that keeps going until
                         the message is verified done
                             [string] [choices: "manual", "default", "accept-edits", "auto", "goal"]
      --auto             auto mode: approve everything except risky actions, which are refused with
                         the reason                                       [boolean] [default: false]"
`;

