{
  "autoupdate": "notify",
  "share": "disabled",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "*>*": "ask",
      "*--output*": "ask",
      "*--pre*": "ask"
    },
    "webfetch": "ask",
    "external_agent": "ask"
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v7.0.1",
    "@dietrichgebert/ponytail@5.3.2"
  ],
  "mcp": {
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rea-agents@6.8.0",
        "mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.12.0"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "command": {
    "catalog": {
      "description": "browse and manage DeV's skills, plugins and MCP servers",
      "template": "Use the catalog tool to manage DeV's skills, plugins and MCP servers. Request: $ARGUMENTS\n\nIf the request is empty, list the catalog (action list), grouped by kind with each entry's user/project status in one short line each, then ask what to install, enable or disable. Otherwise carry the request out with the catalog tool and report the result."
    }
  },
  "marketplaces": {
    "dev": {
      "source": "Harsha-code-per/dev-marketplace"
    }
  }
}
