#!/bin/sh
# Run a heavy command (build, typecheck, tests) under a memory cap so it is killed
# instead of freezing the desktop. Usage: scripts/capped [MAX] -- cmd...   (default MAX=4G)
max=4G
[ "$1" != "--" ] && [ -n "$1" ] && { max=$1; shift; }
[ "$1" = "--" ] && shift
# A scope lives until its last process exits, so anything the command leaves behind (a test's
# socat bridge, a server) kept each run's scope alive; eight of them ran a 16 GB machine out of
# memory. Stop the scope when the command ends, and cap its life in case this shell is killed first.
unit="capped-$$-$(date +%s)"
trap 'systemctl --user stop "$unit.scope" 2>/dev/null' EXIT INT TERM HUP
systemd-run --user --scope --quiet --unit="$unit" -p RuntimeMaxSec=2h -p MemoryMax="$max" -p MemorySwapMax=1G -p CPUWeight=50 -- "$@"
