#!/bin/sh
# Run a heavy command (build, typecheck, tests) under a memory cap so it is killed
# instead of freezing the desktop. Usage: scripts/capped [MAX] -- cmd...   (default MAX=4G)
max=4G
[ "$1" != "--" ] && [ -n "$1" ] && { max=$1; shift; }
[ "$1" = "--" ] && shift
exec systemd-run --user --scope --quiet -p MemoryMax="$max" -p MemorySwapMax=1G -p CPUWeight=50 -- "$@"
